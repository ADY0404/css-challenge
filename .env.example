# Example Django Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your real values below.

DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank for local SQLite (default). On Render this is auto-set from
# the linked PostgreSQL database. You can also paste an External DB URL here
# if you want to point local dev at a remote database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Brevo (Sendinblue) Transactional Email ───────────────────────────────────
# 1. Log in to app.brevo.com → Settings → SMTP & API
# 2. Copy "SMTP login" → paste as BREVO_SMTP_LOGIN
# 3. Click "Generate a new SMTP key" → paste as BREVO_API_KEY
# 4. Add a verified sender address at Senders, Domains & Dedicated IPs
# 5. Set DEFAULT_FROM_EMAIL to one of your verified senders.
BREVO_SMTP_LOGIN=your-brevo-account@email.com
BREVO_API_KEY=xsmtpsib-xxxx-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=CSS Society <noreply@yourdomain.com>

# Google reCAPTCHA v2 (official test keys — safe for localhost only)
RECAPTCHA_ENABLED=True
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe


